# Copy to .env (git-ignored) and fill in. NEVER commit .env or paste these in chat.
# All four are server-side only. Nothing here reaches the browser.

# Neon dashboard -> Connect -> "Pooled connection" string (host contains -pooler)
DATABASE_URL=
GEMINI_API_KEY=
GNANI_API_KEY=
# Pick any passcode for the Admin page (8 or more characters)
ADMIN_PASSCODE=

# Optional overrides
# GNANI_MODEL=prisma-v2.5
# GEMINI_MODEL=gemini-3.1-flash-lite
